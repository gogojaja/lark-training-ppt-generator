    "adjectives": ["沉稳", "克制", "权威"],
    "tension": "严肃但不压抑"
  },
  "characteristics": {
    "visual": [
      "深灰主色 + 琥珀黄强调色",
      "侧边栏 motif + 章节编号",
      "大量留白 + 极简装饰"
    ],
    "typography": [
      "标题简洁有力",
      "正文紧凑",
      "表格和时间线为主"
    ],
    "layout": [
      "侧边栏导航布局",
      "表格和时间线为主",
      "大量留白"
    ]
  },
  "palette": {
    "primary": { "value": "404040", "role": "深灰 - 主色调" },
    "secondary": { "value": "808080", "role": "中灰 - 次要" },
    "accent": { "value": "F59E0B", "role": "琥珀黄 - 强调" },
    "background": { "value": "FFFFFF", "role": "白色背景" },
    "text": { "value": "1F2937", "role": "近黑文字" },
