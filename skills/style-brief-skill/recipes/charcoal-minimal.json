      "annotation": { "size": 11, "weight": "normal", "lineHeight": 1.4 },
      "source": { "size": 9, "weight": "normal", "lineHeight": 1.3 }
    }
  },
  "layouts": [
    {
      "id": "cover",
      "name": "封面页",
      "description": "深灰背景 + 大号标题",
      "useCase": "正式汇报封面"
    },
    {
      "id": "sidebar",
      "name": "侧边栏导航",
      "description": "左侧导航 + 右侧内容",
      "useCase": "章节内容"
    },
    {
      "id": "table",
      "name": "表格页",
      "description": "紧凑表格 + 数据展示",
      "useCase": "数据对比"
    },
    {
      "id": "timeline",
      "name": "时间线页",
      "description": "垂直时间线 + 里程碑",
      "useCase": "进度汇报"
    },
    {
      "id": "matrix",
      "name": "决策矩阵",
      "description": "网格布局 + 决策点",
      "useCase": "方案对比"
    }
  ],
  "remixKnobs": [
    {
      "id": "gray-depth",
      "name": "灰度深浅",
      "description": "调节灰色主色调的深浅",
      "range": ["浅灰(轻松)", "标准灰", "深灰(正式)"]
    },
    {
      "id": "sidebar-width",
      "name": "侧边栏宽度",
      "description": "调节侧边栏宽度",
      "range": ["窄栏", "标准", "宽栏"]
    },
    {
      "id": "accent-saturation",
      "name": "强调色饱和度",
      "description": "调节强调色的饱和度",
      "range": ["低饱和", "标准", "高饱和"]
    },
    {
      "id": "whitespace",
      "name": "留白比例",
      "description": "控制页面留白",
      "range": ["紧凑", "标准", "宽松"]
    }
  ],
  "failureSignals": [
    "标题主导页面，内容被压缩",
    "行高很高但文字很小，阅读困难",
    "正文紧跟标题下方，缺少停顿",
    "下三分之一未使用，底部空白",
    "过多圆角卡片让报告像仪表盘",
    "状态颜色变成装饰而非语义"
  ],
  "scenarios": [
    "合规培训",
    "风控宣贯",
    "管理层汇报",
    "制度解读"
