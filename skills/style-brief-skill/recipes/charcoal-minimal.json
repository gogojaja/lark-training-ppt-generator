      "success": "10B981",
      "warning": "F59E0B",
      "error": "EF4444"
    }
  },
  "typography": {
    "family": {
      "heading": "Microsoft YaHei",
      "body": "Microsoft YaHei",
      "mono": "Consolas"
    },
    "roles": {
